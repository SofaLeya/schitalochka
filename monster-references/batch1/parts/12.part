","thought":"data:image/png;base64,","content":"data:image/png;base64,","determined":"data:image/png;base64,"}}}, MOVES=[["idle","Дыхание",3.5],["blink","Моргание",2],["sway","Покачивание",2],["joy","Радость",1.5],["jump","Прыжок",1.2],["flip","Сальтуха",1.5],["sleep","Сон",5],["happy","Счастье",3],["surprise","Удивление",1.6],["interest","Интерес",2.8],["thought","Задумчивость",3.4],["content","Довольство",3.5],["determined","Решимость",2.2]];const names=Object.keys(DATA),c=document.querySelector('canvas'),ctx=c.getContext('2d');let n=names[0],k='idle',start=performance.now(),paused=false,auto=false,last=0,pausedAt=0;const $=s=>document.getElementById(s), imgs={};for(const name of names){imgs[name]={};for(const [key,src] of Object.entries(DATA[name].sprites)){const im=new Image();im.src=src;imgs[name][key]=im}}let marks={};try{marks=JSON.parse(localStorage.getItem('schitalochka-batch1-review')||'{}')}catch(e){}function persist(){try{localStorage.setItem('schitalochka-batch1-review',JSON.stringify(marks))}catch(e){} }
function state(k,t){const p=Math.sin(Math.PI*t)**2,b=Math.sin(2*Math.PI*t-Math.PI/2)*.5+.5;let pose=k,sx=1,sy=1,y=0,rot=0,eff='';if(k==='idle'){sx=1+.012*b;sy=1+.027*b}else if(k==='blink'){pose=t>.42&&t<.57?'blink':'idle'}else if(k==='sway'){pose='idle';rot=7*Math.sin(2*Math.PI*t)*p}else if(k==='joy'){pose=t>.10&&t<.91?'joy':'idle';sy=1+.035*Math.sin(4*Math.PI*t)*p;eff='stars'}else if(k==='jump'){pose=t>.22&&t<.76?'jump':'idle';y=-76*p;sy=1-.14*Math.exp(-(((t-.14)/.07)**2))-.13*Math.exp(-(((t-.84)/.07)**2));sx=1+(1-sy)*.75}else if(k==='flip'){pose=t<.19||t>.79?'idle':t<.49?'flip1':'flip2';y=-98*p;sy=1-.18*Math.exp(-(((t-.14)/.075)**2))-.15*Math.exp(-(((t-.84)/.075)**2));sx=1+(1-sy)*.65;eff=t>.19&&t<.79?'vortex':''}else if(k==='sleep'){sy=.96+.025*b;eff='zzz'}else if(k==='happy'){sy=1+.018*b;eff='stars'}else if(k==='surprise'){pose=t>.1&&t<.84?'surprise':'idle';sy=1+.08*p;sx=1-.025*p;eff='!'}else if(k==='interest'){pose=t>.10&&t<.90?'interest':'idle';rot=-5*p;eff='?'}else if(k==='thought'){pose=t>.10&&t<.90?'thought':'idle';rot=-4*p;eff='dots'}else if(k==='content'){sy=1+.025*b}else if(k==='determined'){pose=t>.10&&t<.90?'determined':'idle';sy=1+.025*p}return {pose,sx,sy,y,rot,eff,p}}
function draw(k,t){const {pose,sx,sy,y,rot,eff,p}=state(k,t),im=imgs[n][pose];ctx.fillStyle='#190f27';ctx.fillRect(0,0,320,320);ctx.fillStyle='#0d0915';ctx.beginPath();ctx.ellipse(160,268,56-20*p*(['jump','flip'].includes(k)?1:0),6,0,0,Math.PI*2);ctx.fill();if(!im.complete||!im.naturalWidth)return;let w=206*sx,h=206*im.naturalHeight/im.naturalWidth*sy;if(k==='flip'&&pose!=='idle'){w*=.90;h*=.90}const angle=rot*Math.PI/180, anchor=267+y; const corners=[[-w/2,-h],[w/2,-h],[-w/2,0],[w/2,0]].map(([x,y])=>[x*Math.cos(angle)-y*Math.sin(angle),x*Math.sin(angle)+y*Math.cos(angle)]); const loX=Math.min(...corners.map(q=>q[0])),hiX=Math.max(...corners.map(q=>q[0])),loY=Math.min(...corners.map(q=>q[1])),hiY=Math.max(...corners.map(q=>q[1])); const fit=Math.min(1,148/Math.max(1,-loX,hiX),(anchor-12)/Math.max(1,-loY),(308-anchor)/Math.max(1,hiY));w*=fit;h*=fit;const top=Math.max(12,anchor+loY*fit);ctx.save();ctx.translate(160,anchor);ctx.rotate(angle);ctx.drawImage(im,-w/2,-h,w,h);ctx.restore();ctx.fillStyle='#da9dfa';ctx.font='bold 34px system-ui';if(eff==='dots'){for(let i=0;i<3;i++)if(t>.14+i*.13&&t<.91){ctx.beginPath();ctx.arc(242+i*20,Math.max(52,top+20)-i*17,5+i*1.5,0,Math.PI*2);ctx.fill()}}else if((eff==='?'||eff==='!')&&t>.12&&t<.85){if(eff==='!')ctx.fillStyle='#ffde68';ctx.save();ctx.shadowColor=ctx.fillStyle;ctx.shadowBlur=7;ctx.fillText(eff,263,Math.max(43,top+5));ctx.restore()}else if(eff==='zzz'){for(let i=0;i<3;i++){ctx.font=`bold ${15+i*3}px system-ui`;ctx.fillText('z',240+i*18,Math.max(44,top+30)-i*13)}}else if(eff==='stars'&&t>.14&&t<.88){ctx.strokeStyle='#ffdc69';ctx.lineWidth=2;for(const [x,y]of [[56,top+22],[253,top+14],[265,top+38]]){ctx.beginPath();ctx.moveTo(x-5,y);ctx.lineTo(x+5,y);ctx.moveTo(x,y-5);ctx.lineTo(x,y+5);ctx.stroke()}}else if(eff==='vortex'){let cy=Math.min(238,Math.max(82,267+y-h/2)),ang=t*950*Math.PI/180;ctx.strokeStyle='#dbc0fe';ctx.lineWidth=3;for(let a of [ang,ang+Math.PI]){ctx.beginPath();ctx.ellipse(160,cy,120,80,0,a,a+1.95);ctx.stroke()}}}
function select(name,key){n=name;k=key;start=performance.now();last=0;paused=false;$('pause').textContent='Пауза';update()}
function update(){const id=n+'|'+k;document.querySelectorAll('[data-name]').forEach(b=>b.classList.toggle('sel',b.dataset.name===n));document.querySelectorAll('[data-key]').forEach(b=>{b.classList.toggle('sel',b.dataset.key===k);const m=marks[n+'|'+b.dataset.key];b.textContent=MOVES.find(x=>x[0]===b.dataset.key)[1]+(m?.status==='ok'?' ✓':m?.status==='fix'?' !':'')});$('name').textContent=n;$('motion').textContent=MOVES.find(x=>x[0]===k)[1];$('rule').textContent=DATA[n].map.description+' '+DATA[n].map.motion_rule;$('note').value=marks[id]?.note||'';let ok=Object.values(marks).filter(x=>x.status==='ok').length,fix=Object.values(marks).filter(x=>x.status==='fix').length;$('count').textContent=`Согласовано ${ok}/65 · правки ${fix}`}
for(const name of names){let b=document.createElement('button');b.dataset.name=name;b.textContent=name;b.onclick=()=>{auto=false;select(name,k)};$('tabs').append(b)}for(const [key,label]of MOVES){let b=document.createElement('button');b.dataset.key=key;b.textContent=label;b.onclick=()=>{auto=false;select(n,key)};$('moves').append(b)}$('play').onclick=()=>{auto=false;select(n,k)};$('pause').onclick=()=>{if(paused){start+=performance.now()-pausedAt;paused=false;$('pause').textContent='Пауза'}else{pausedAt=performance.now();paused=true;$('pause').textContent='Продолжить'}};$('all').onclick=()=>{auto=true;select(n,'idle')};function mark(status){let id=n+'|'+k;marks[id]={status,note:$('note').value};persist();update()}$('ok').onclick=()=>mark('ok');$('fix').onclick=()=>mark('fix');$('note').oninput=()=>{let id=n+'|'+k;marks[id]={status:marks[id]?.status||'pending',note:$('note').value};persist()};$('export').onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(marks,null,2)],{type:'application/json'}));a.download='monster-batch1-review.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
function tick(now){if(!paused){const dur=MOVES.find(x=>x[0]===k)[2]*1000,elapsed=now-start;let t=elapsed/dur;if(t>=1&&auto){let i=MOVES.findIndex(x=>x[0]===k);if(i<MOVES.length-1){select(n,MOVES[i+1][0]);t=0}else{auto=false;select(n,'idle');t=0}}else if(t>=1&&!['idle','sleep','happy','content'].includes(k)){draw(k==='blink'?'blink':'idle',k==='blink'?1:((elapsed-dur)%3500)/3500);requestAnimationFrame(tick);return}draw(k,t%1)}requestAnimationFrame(tick)}update();requestAnimationFrame(tick);
</script></html>