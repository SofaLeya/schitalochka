", "data:image/png;base64,", "data:image/png;base64,"], durations=[350, 260, 350, 550, 850, 350, 260, 430];const pet=document.getElementById('pet'),play=document.getElementById('play'),pause=document.getElementById('pause');frames.forEach(src=>{const i=new Image();i.src=src});let t=0,last=null,running=false,paused=false;pet.src=frames[0];function draw(now){if(last===null)last=now;if(running&&!paused){t+=now-last;let elapsed=0,idx=0;while(idx<durations.length&&t>=elapsed+durations[idx]){elapsed+=durations[idx++]}if(idx>=frames.length){running=false;pet.src=frames[0]}else if(pet.getAttribute('src')!==frames[idx])pet.src=frames[idx]}last=now;requestAnimationFrame(draw)}play.onclick=()=>{t=0;last=null;running=true;paused=false;pause.textContent='Пауза';pet.src=frames[0]};pause.onclick=()=>{paused=!paused;pause.textContent=paused?'Продолжить':'Пауза';last=null};requestAnimationFrame(draw);</script></html>